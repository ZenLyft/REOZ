{
  "name": "zenlyft-revenue-engine",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@zenlyft/web",
    "build": "npm run build --workspace=@zenlyft/web",
    "cf:build": "npm run cf:build --workspace=@zenlyft/web",
    "cf:deploy": "npm run cf:deploy --workspace=@zenlyft/web",
    "cf:upload": "npm run cf:upload --workspace=@zenlyft/web",
    "whatsapp:gateway": "node -r dotenv/config automation/whatsapp-gateway.mjs",
    "lint": "npm run lint --workspace=@zenlyft/web",
    "test": "npm run test --workspace=@zenlyft/web"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  }
}
