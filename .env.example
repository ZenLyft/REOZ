# ======================================================================
# ZENLYFT REVENUE ENGINE - ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env.local (apps/web) and .env (workers)
# NEVER commit real API keys or credentials to version control.
# ======================================================================

# --- NEXT.JS APP CONFIG ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- SUPABASE CONFIG ---
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-only Service Role Key (NEVER expose to browser / client code)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# --- TELEGRAM BOT ALERTS ---
# Created via @BotFather in Telegram
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
# Your personal Telegram chat ID (obtain from @userinfobot)
TELEGRAM_FOUNDER_CHAT_ID="your-telegram-chat-id"

# --- FREE-TIER AI PROVIDERS ---
# Google AI Studio (Free Tier: 15 RPM on Gemini 2.0 / 1.5 Flash)
GEMINI_API_KEY="your-gemini-api-key"

# Groq (Optional free tier fallback)
GROQ_API_KEY="your-groq-api-key"

# Selected active model provider: 'gemini' | 'groq' | 'mock'
DEFAULT_AI_PROVIDER="mock"

# --- RATE LIMITING & SECURITY ---
# Max failed login attempts within 15 minutes before temporary lockout
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# --- EVOLUTION API (OPEN SOURCE AUTOMATED WHATSAPP GATEWAY) ---
# GitHub: https://github.com/evolution-foundation/evolution-api
# Base URL of your self-hosted Evolution API instance (Local or Railway/Render/VPS)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="zenlyft-reoz-secret-key-2026"
EVOLUTION_INSTANCE_NAME="zenlyft-reoz"
OPENWA_BUSINESS_PHONE="+91 80159 29139"

